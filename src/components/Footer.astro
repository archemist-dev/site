---
import { LINKS } from '../consts';

const links = [
	{ href: LINKS.newsletter, label: 'Newsletter' },
	{ href: LINKS.youtube, label: 'YouTube' },
	{ href: LINKS.telegram, label: 'Telegram' },
	{ href: LINKS.x, label: 'X' },
	{ href: LINKS.threads, label: 'Threads' },
	{ href: LINKS.medium, label: 'Medium' },
	{ href: LINKS.github, label: 'GitHub' },
	{ href: '/rss.xml', label: 'RSS' },
].filter((link) => link.href);
---

<footer>
	<div class="inner">
		<p class="mono">© {new Date().getFullYear()} Archemist · <a href={LINKS.email}>hello@archemist.dev</a></p>
		<ul>
			{links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
		</ul>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--border);
		font-size: 0.85rem;
		color: var(--muted);
	}
	.inner {
		max-width: var(--wide);
		margin: 0 auto;
		padding: 1.5rem 16px 2.5rem;
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 1rem;
	}
	p {
		margin: 0;
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.1rem;
	}
	li {
		margin: 0;
	}
	a {
		color: var(--muted);
		text-decoration: none;
	}
	a:hover {
		color: var(--text);
	}
</style>
