---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { Font, getImage } from 'astro:assets';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import DefaultImage from '../assets/og-default.png';
import { LINKS, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

interface Props {
	title?: string;
	description: string;
	image?: ImageMetadata;
	imageAlt?: string;
	article?: { pubDate: Date };
}

const { title, description, image, imageAlt, article } = Astro.props;
const fullTitle = title ? `${title} | ${SITE_TITLE}` : `${SITE_TITLE}: software architecture, tested`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = await getImage({ src: image ?? DefaultImage, format: 'png', width: image ? 1200 : 512 });
const ogImageURL = new URL(ogImage.src, Astro.site);

// Structured data for search engines: an article gets BlogPosting, every other page the site itself.
const author = { '@type': 'Person', name: 'Javlon', url: new URL('/about/', Astro.site) };
const publisher = {
	'@type': 'Organization',
	name: SITE_TITLE,
	url: Astro.site,
	logo: new URL('/apple-touch-icon.png', Astro.site),
	sameAs: [LINKS.newsletter, LINKS.youtube, LINKS.x, LINKS.threads, LINKS.telegram, LINKS.medium, LINKS.github].filter(Boolean),
};
const jsonLd = article
	? {
			'@context': 'https://schema.org',
			'@type': 'BlogPosting',
			headline: title,
			description,
			image: ogImageURL,
			datePublished: article.pubDate.toISOString(),
			url: canonicalURL,
			mainEntityOfPage: canonicalURL,
			author,
			publisher,
		}
	: {
			'@context': 'https://schema.org',
			'@type': 'WebSite',
			name: SITE_TITLE,
			description: SITE_DESCRIPTION,
			url: Astro.site,
			publisher,
		};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<meta name="theme-color" content="#1b1d21" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/svg+xml" href="/logo.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('rss.xml', Astro.site)} />
		<Font cssVariable="--font-inter" preload />
		<Font cssVariable="--font-serif" preload />
		<Font cssVariable="--font-mono" />

		<link rel="canonical" href={canonicalURL} />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />

		<meta property="og:site_name" content={SITE_TITLE} />
		<meta property="og:type" content={article ? 'article' : 'website'} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title ?? SITE_TITLE} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content={String(ogImage.attributes.width)} />
		<meta property="og:image:height" content={String(ogImage.attributes.height)} />
		{imageAlt && <meta property="og:image:alt" content={imageAlt} />}
		{article && <meta property="article:published_time" content={article.pubDate.toISOString()} />}
		<meta name="author" content="Javlon" />
		<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:site" content="@archemist_dev" />
		<meta name="twitter:title" content={title ?? SITE_TITLE} />
		<meta name="twitter:description" content={description} />
		{imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>
